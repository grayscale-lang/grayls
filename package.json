{
  "name": "ezls",
  "displayName": "EZ Language Support",
  "description": "Language server for the EZ programming language: diagnostics, completion, hover, and go-to-definition",
  "version": "0.1.0",
  "publisher": "ez-lang",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": ["Programming Languages"],
  "activationEvents": ["onLanguage:ez"],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "ez",
        "aliases": ["EZ", "ez"],
        "extensions": [".ez"],
        "configuration": "./language-configuration.json"
      }
    ]
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node esbuild.js",
    "compile": "tsc -p tsconfig.json",
    "watch": "tsc -watch -p tsconfig.json",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "dependencies": {
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.11"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.80.0",
    "esbuild": "^0.20.0",
    "typescript": "^5.4.0",
    "vscode-languageclient": "^9.0.1"
  }
}
